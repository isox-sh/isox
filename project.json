{
  "$schema": "./packages/core/schemas/project.schema.json",
  "name": "workspace",
  "targets": {
    "version": {
      "executor": "semver:version",
      "options": {
        "push": false,
        "skipCommit": true,
        "syncVersions": true,
        "skipProjectChangelog": true
      },
      "configurations": {
        "production": {
          "postTargets": [
            "workspace:npm",
            "workspace:push-tag",
            "workspace:github"
          ]
        }
      }
    },
    "test": {
      "executor": "vitest:test"
    },
    "npm": {
      "executor": "core:run-command",
      "options": {
        "command": "node scripts/release.mjs --version={version} --tag={npmTag}"
      }
    },
    "push-tag": {
      "executor": "core:run-command",
      "options": {
        "command": "git push origin \"refs/tags/{tag}:refs/tags/{tag}\""
      }
    },
    "github": {
      "executor": "semver:github",
      "options": {
        "tag": "{tag}",
        "notes": "{notes}",
        "prerelease": "{prerelease}"
      }
    }
  },
  "tags": []
}
