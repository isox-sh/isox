{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Isox",
  "description": "Run your monorepo with explicit project configuration. Guides and reference for Isox commands, executors, affected projects, and CI.",
  "colors": {
    "primary": "#3B82F6",
    "light": "#8AB6FF",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "/"
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "docs/introduction",
              "docs/getting-started",
              "docs/concepts"
            ]
          },
          {
            "group": "Run your workspace",
            "pages": [
              "docs/shell-commands",
              "docs/task-prerequisites",
              "docs/task-caching",
              "docs/cache-inputs",
              "docs/cache-outputs",
              "docs/cache-limits"
            ]
          },
          {
            "group": "Build and test",
            "pages": [
              "docs/typescript",
              "docs/typescript-builds",
              "docs/typescript-packages",
              "docs/eslint",
              "docs/vitest"
            ]
          },
          {
            "group": "Continuous integration",
            "pages": [
              "docs/affected-and-ci",
              "docs/ci-planning",
              "docs/github-actions"
            ]
          },
          {
            "group": "Release and migrate",
            "pages": [
              "docs/semver",
              "docs/prereleases",
              "docs/release-publishing",
              "docs/migrations",
              "docs/nx-migration",
              "docs/prompts/migrate-nx-to-isox"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "docs/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Plugin Registry",
        "groups": [
          {
            "group": "Discover plugins",
            "pages": [
              "docs/plugin-registry",
              "docs/submit-plugin"
            ]
          }
        ]
      },
      {
        "tab": "Build plugins",
        "groups": [
          {
            "group": "Build a plugin",
            "pages": [
              "docs/custom-plugins",
              "docs/plugin-quickstart",
              "docs/plugin-packaging"
            ]
          },
          {
            "group": "Add capabilities",
            "pages": [
              "docs/custom-executors",
              "docs/plugin-generators",
              "docs/plugin-migrations"
            ]
          },
          {
            "group": "Test and integrate",
            "pages": [
              "docs/plugin-testing",
              "docs/plugin-helpers",
              "docs/core-api",
              "docs/planning-api"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI and configuration",
            "pages": [
              "docs/cli",
              "docs/configuration",
              "docs/project-configuration",
              "docs/release-options"
            ]
          },
          {
            "group": "Workspace internals",
            "pages": [
              "docs/project-discovery",
              "docs/discovery-cache"
            ]
          },
          {
            "group": "Contribute to Isox",
            "pages": [
              "docs/contributing",
              "docs/repository-builds",
              "docs/repository-releases"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
