      "destination": "/docs/semver"
    },
    {
      "source": "/core-api",
      "destination": "/docs/core-api"
    },
    {
      "source": "/custom-executors",
      "destination": "/docs/custom-executors"
    },
    {
      "source": "/plugin-testing",
      "destination": "/docs/plugin-testing"
    },
    {
      "source": "/nx-migration",
      "destination": "/docs/nx-migration"
    },
    {
      "source": "/prompts/migrate-nx-to-isox",
      "destination": "/docs/prompts/migrate-nx-to-isox"
    },
    {
      "source": "/contributing",
      "destination": "/docs/contributing"
    }
  ]
