{
  "name": "isox-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight monorepo command runner with explicit project configuration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isox-sh/isox.git"
  },
  "homepage": "https://isox.sh",
