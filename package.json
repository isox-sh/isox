  "repository": {
    "type": "git",
    "url": "git+https://github.com/isox-sh/isox.git"
  },
  "homepage": "https://isox.sh",
  "bugs": {
    "url": "https://github.com/isox-sh/isox/issues"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "isox": "node dist/cli/index.js",
    "lint": "eslint . --max-warnings 0",
