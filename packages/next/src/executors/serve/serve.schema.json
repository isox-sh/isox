{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Next.js serve",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ],
      "default": "development",
      "description": "Use development mode or serve an existing production build."
    },
    "bundler": {
      "type": "string",
      "enum": [
        "turbopack",
        "webpack"
      ],
      "description": "Override Next.js’s default bundler."
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Hostname or address to bind to."
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Port to bind to. Use 0 for an available port."
    }
  },
  "additionalProperties": false
}
