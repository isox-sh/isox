{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "ESLint lint executor",
  "type": "object",
  "properties": {
    "lintFilePatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": "Files, directories, or globs relative to the workspace root. Defaults to the project root."
    },
    "configFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "ESLint configuration path relative to the workspace root, or absolute."
    },
    "fix": {
      "type": "boolean",
      "default": false
    },
    "maxWarnings": {
      "type": "integer",
      "minimum": -1,
      "default": 0
    }
  },
  "additionalProperties": false
}
