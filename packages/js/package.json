{
  "name": "@isox-sh/js",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Native TypeScript compiler executor for Isox.",
  "executors": "./executors.json",
  "init": "../../dist/js/generators/init.js",
  "files": [
    "dist",
    "executors.json"
  ],
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "fast-glob": "^3.3.3",
    "ajv": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isox-sh/isox.git",
    "directory": "packages/js"
  },
  "homepage": "https://isox.sh",
  "bugs": {
    "url": "https://github.com/isox-sh/isox/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "directory": "../../dist/js",
    "linkDirectory": true,
    "exports": {
      "./helpers": {
        "types": "./helpers/index.d.ts",
        "default": "./helpers/index.js"
      },
      "./helpers/package-json": {
        "types": "./helpers/package-json.d.ts",
        "default": "./helpers/package-json.js"
      },
      "./*": "./*"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "default": "./src/helpers/index.ts"
    },
    "./helpers/package-json": {
      "types": "./src/helpers/package-json.ts",
      "default": "./src/helpers/package-json.ts"
    },
    "./*": "./*"
  }
}
