{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Initialize a JS project",
  "type": "object",
  "properties": {
    "importPath": {
      "type": "string",
      "pattern": "^[^\\s:*]+$",
      "description": "Add an import alias for the project to tsconfig.base.json."
    },
    "linter": {
      "type": "string",
      "enum": ["eslint", "none"],
      "default": "eslint",
      "description": "Configure ESLint, or skip lint setup."
    }
  },
  "additionalProperties": false
}
