{
  "$schema": "../core/schemas/project.schema.json",
  "name": "e2e-plugin",
  "targets": {
    "build": {
      "executor": "js:tsc",
      "options": {
        "tsConfig": "packages/e2e/tsconfig.build.json",
        "generatePackageJson": true
      },
      "outputs": [
        "{workspaceRoot}/dist/e2e"
      ]
    },
    "test": {
      "executor": "vitest:test"
    },
    "lint": {
      "executor": "eslint:lint"
    }
  },
  "tags": []
}
