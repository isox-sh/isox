{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Isox workspace",
  "type": "object",
  "properties": {
    "nx": {
      "type": "object",
      "properties": {
        "executors": {
          "description": "Npm scopes or package names whose executors always use the Nx adapter. Init includes @nx by default.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:@[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)?|[a-zA-Z0-9._-]+)$"
          }
        }
      }
    }
  }
}
