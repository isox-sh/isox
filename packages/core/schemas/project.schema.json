{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Isox project",
  "description": "Configuration for an Isox project. Its root is the directory containing this file.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL to this JSON Schema."
    },
    "name": {
      "type": "string",
      "pattern": "^[^\\s:]+$",
      "description": "Unique project name. Defaults to the containing directory name."
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^\\s:]+$"
      },
      "description": "Additional project dependencies, merged with imports and local package references during on-demand dependency analysis. Used by affected selection and ^target task prerequisites."
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\s:]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/executor"
      },
      "description": "Commands available through isox <command> <target>, where target is the project name."
    },
    "plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include this project in affected, plan, and ordinary run-many selection. Direct commands and exact project lists can still run it."
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "Relative cost of this project when balancing CI shards. A higher weight represents more work."
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Labels for organizing projects."
    },
    "namedInputs": {
      "$ref": "#/definitions/namedInputs"
    }
  },
  "definitions": {
    "executor": {
      "type": "object",
      "required": [
        "executor"
      ],
      "properties": {
        "executor": {
          "type": "string",
          "pattern": "^[^\\s:]+:[^\\s:]+$",
          "description": "Executor reference in package:executor format."
        },
        "options": {
          "type": "object",
          "description": "Options passed to the executor."
        },
        "configurations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s:,]+$"
          },
          "additionalProperties": {
            "type": "object"
          },
          "description": "Named overrides merged over options. Nested objects and arrays are replaced."
        },
        "defaultConfiguration": {
          "type": "string",
          "pattern": "^[^\\s:,]+$",
          "description": "Configuration selected when no configuration is specified on the command line."
        },
        "cache": {
          "type": "boolean",
          "default": false,
          "description": "Reuse successful native task results. Outputs are exclusively owned, disposable directories."
        },
        "inputs": {
          "$ref": "#/definitions/taskInputs"
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exclusive output directories, relative to the workspace. No globs. Omit for logs-only caching; use [] to clear inherited outputs."
        },
        "dependsOn": {
          "$ref": "#/definitions/dependsOn"
        }
      },
      "additionalProperties": true
    },
    "targetDefaults": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "description": "Options passed to the executor."
        },
        "configurations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s:,]+$"
          },
          "additionalProperties": {
            "type": "object"
          },
          "description": "Named overrides merged over options. Nested objects and arrays are replaced."
        },
        "defaultConfiguration": {
          "type": "string",
          "pattern": "^[^\\s:,]+$",
          "description": "Configuration selected when no configuration is specified on the command line."
        },
        "cache": {
          "type": "boolean",
          "default": false,
          "description": "Reuse successful native task results. Outputs are exclusively owned, disposable directories."
        },
        "inputs": {
          "$ref": "#/definitions/taskInputs"
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exclusive output directories, relative to the workspace. No globs. Omit for logs-only caching; use [] to clear inherited outputs."
        },
        "dependsOn": {
          "$ref": "#/definitions/dependsOn"
        }
      },
      "additionalProperties": true
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              },
              "projects": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "dependencies": {
                "type": "boolean"
              },
              "params": {
                "enum": [
                  "forward",
                  "ignore"
                ]
              },
              "options": {
                "enum": [
                  "forward",
                  "ignore"
                ]
              }
            },
            "not": {
              "required": [
                "projects",
                "dependencies"
              ]
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "Tasks that must succeed first. Use target for this project or ^target for dependency projects."
    },
    "taskInputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "env"
            ],
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "File patterns, named input references, dependency references prefixed with ^, or environment inputs."
    },
    "namedInputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/taskInputs"
      }
    }
  }
}
