{
  "$schema": "../core/schemas/project.schema.json",
  "name": "cli",
  "dependencies": [
    "core"
  ],
  "commands": {
    "build": {
      "executor": "js:tsc",
      "options": {
        "tsConfig": "packages/cli/tsconfig.json"
      }
    },
    "test": {
      "executor": "vitest:test"
    },
    "lint": {
      "executor": "core:run-command",
      "options": {
        "command": "pnpm exec eslint packages/cli --max-warnings 0"
      }
    }
  },
  "tags": []
}
